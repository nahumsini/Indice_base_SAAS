<mxfile host="app.diagrams.net" modified="2026-05-18T22:34:00.000Z" agent="Codex" version="26.0.11" type="device">
  <diagram id="users-initial-panel-flow" name="Users Initial Panel Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="Users Tab / Initial Panel&#xa;High-level confirmation flow before Root Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4b99;fontColor=#ffffff;strokeColor=#163a77;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="30" width="860" height="70" as="geometry" />
        </mxCell>

        <mxCell id="3" value="Main flow" style="swimlane;fontStyle=1;horizontal=0;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="1180" height="700" as="geometry" />
        </mxCell>

        <mxCell id="10" value="1. Review users and invitations&#xa;- Open Users tab&#xa;- See active users and pending invites&#xa;- Use this as the starting management panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="40" y="70" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="11" value="2. Manage existing user&#xa;- Role&#xa;- Membership: Business Unit and Business&#xa;- Module access&#xa;- Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="430" y="70" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="12" value="3. Invite new user&#xa;- Name&#xa;- Email&#xa;- Role&#xa;- Module access&#xa;- Invitation accepted later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="820" y="70" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="13" value="4. Apply access rules&#xa;- Root / Super Admin / Admin manage this screen&#xa;- Normal users do not manage users or invitations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="240" y="320" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="14" value="5. Expected result&#xa;- Membership is saved correctly&#xa;- Invitations follow the same logic&#xa;- Access rules are clear&#xa;- Then we move to Root Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="3">
          <mxGeometry x="650" y="310" width="360" height="140" as="geometry" />
        </mxCell>

        <mxCell id="15" value="Membership in this flow means:&#xa;Business Unit + Business assignment for the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;" vertex="1" parent="3">
          <mxGeometry x="380" y="520" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="20" value="Questions to confirm" style="swimlane;fontStyle=1;horizontal=0;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1270" y="140" width="650" height="700" as="geometry" />
        </mxCell>

        <mxCell id="21" value="1. Is the Users tab the main source of truth for user membership?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="30" y="70" width="590" height="80" as="geometry" />
        </mxCell>

        <mxCell id="22" value="2. Should Business Unit and Business be editable here for existing users?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="30" y="180" width="590" height="80" as="geometry" />
        </mxCell>

        <mxCell id="23" value="3. Should invitations already include membership, or only role and module access?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="30" y="290" width="590" height="80" as="geometry" />
        </mxCell>

        <mxCell id="24" value="4. Which roles should manage this screen in production?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="30" y="400" width="590" height="80" as="geometry" />
        </mxCell>

        <mxCell id="25" value="If this flow is correct, next step is to finish this Users panel first, then prepare the Root Dashboard proposal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="30" y="540" width="590" height="100" as="geometry" />
        </mxCell>

        <mxCell id="100" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="3" source="10" target="11">
          <mxGeometry relative="1" as="geometry" />
