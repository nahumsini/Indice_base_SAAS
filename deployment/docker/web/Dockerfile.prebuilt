ARG BASE_IMAGE=indice-erp-web:latest
FROM ${BASE_IMAGE}

ARG WEB_NGINX_CONFIG=deployment/docker/web/nginx.conf
ARG NGINX_LISTEN_PORT=8080
ARG BACKEND_UPSTREAM=backend:8082
ARG MCP_UPSTREAM=mcp:3010
ARG MINIO_UPSTREAM=minio:9000

# Replace, rather than layer beside, the previous frontend assets so an old
# chunk can never be served accidentally after a rollback or cache miss.
USER root
RUN rm -rf /usr/share/nginx/html/*
COPY --chown=101:101 ${WEB_NGINX_CONFIG} /etc/nginx/conf.d/default.conf
COPY --chown=101:101 react/dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html
RUN sed -i \
    -e "s/listen 8080;/listen 127.0.0.1:${NGINX_LISTEN_PORT};/" \
    -e "s|http://backend:8082|http://${BACKEND_UPSTREAM}|g" \
    -e "s|http://127.0.0.1:8082|http://${BACKEND_UPSTREAM}|g" \
    -e "s|http://mcp:3010|http://${MCP_UPSTREAM}|g" \
    -e "s|http://127.0.0.1:3010|http://${MCP_UPSTREAM}|g" \
    -e "s|http://minio:9000|http://${MINIO_UPSTREAM}|g" \
    -e "s|http://127.0.0.1:9000|http://${MINIO_UPSTREAM}|g" \
    -e "s|Host minio:9000|Host ${MINIO_UPSTREAM}|g" \
    -e "s|Host 127.0.0.1:9000|Host ${MINIO_UPSTREAM}|g" \
    /etc/nginx/conf.d/default.conf
USER 101
