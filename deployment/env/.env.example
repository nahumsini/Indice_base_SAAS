MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=indice_db
MYSQL_USER=indice_user
MYSQL_PASSWORD=indice_pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_CHARACTER_SET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_ENABLED=true

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_ATTENDANCE=indice-hr-attendance
MINIO_BUCKET_BIOMETRIC=indice-hr-biometric
MINIO_BUCKET_DOCUMENTS=indice-hr-documents
MINIO_BUCKET_SALES_DOCUMENTS=indice-sales-documents
MINIO_PRESIGN_EXPIRY_SECONDS=900
APP_STORAGE_REQUIRED=true

WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8082
MYSQL_HOST_PORT=3307
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
FACE_SERVICE_HOST_PORT=8091

WEB_PUBLIC_URL=http://localhost:8080
MINIO_PUBLIC_ENDPOINT=http://localhost:8080/storage
APP_WEB_ALLOWED_ORIGINS=http://localhost:8080
APP_WEB_BASE_URL=http://localhost:8080
APP_WEB_PUBLIC_URL=http://localhost:8080
APP_WEB_INVITATION_BASE_URL=http://localhost:8080
MINIO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=lax
APP_SESSION_TIMEOUT=12h
SERVER_FORWARD_HEADERS_STRATEGY=framework
APP_HR_ATTENDANCE_ENFORCE_LOCATION_RADIUS=false
APP_HR_FACE_ENABLED=true
APP_HR_FACE_SESSION_EXPIRY_SECONDS=600
APP_HR_KIOSK_IDENTIFICATION_TOKEN_SECRET=change-this-to-a-long-random-production-secret
APP_HR_KIOSK_IDENTIFICATION_TOKEN_TTL_SECONDS=180
APP_HR_KIOSK_INACTIVITY_TIMEOUT_SECONDS=180
APP_EXPENSES_KIOSK_INACTIVITY_TIMEOUT_SECONDS=300
APP_EXPENSES_KIOSK_SESSION_TTL_SECONDS=28800
APP_PETTY_CASH_KIOSK_INACTIVITY_TIMEOUT_SECONDS=900
APP_PETTY_CASH_KIOSK_SESSION_TTL_SECONDS=14400
APP_PROCESS_TASKS_KIOSK_INACTIVITY_TIMEOUT_SECONDS=1800
APP_PROCESS_TASKS_KIOSK_SESSION_TTL_SECONDS=28800
APP_KIOSK_TOKEN_PROTECTION_SECRET=change-this-to-a-different-long-random-production-secret
KIOSK_GLOBAL_CENTER_ENABLED=false
KIOSK_MULTI_DASHBOARD_ENABLED=false
APP_EMAIL_ENABLED=true
APP_EMAIL_PROVIDER=sendgrid
APP_EMAIL_FROM=contacto@indiceapp.com
APP_EMAIL_FROM_ADDRESS=contacto@indiceapp.com
APP_EMAIL_FROM_NAME=Indice
APP_EMAIL_REPLY_TO=
APP_EMAIL_SENDGRID_API_KEY=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

VITE_API_BASE_URL=
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
EXPECT_OBJECT_STORAGE=true
