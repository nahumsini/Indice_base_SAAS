MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=indice_db
MYSQL_USER=indice_user
MYSQL_PASSWORD=indice_pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_CHARACTER_SET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci

# Stripe Phase 2 is intentionally disabled. Keep secrets outside Git; in
# production prefer *_FILE paths mounted by the host secret manager.
APP_BILLING_STRIPE_ENABLED=false
APP_BILLING_STRIPE_MODE=test
APP_BILLING_STRIPE_SECRET_KEY=
APP_BILLING_STRIPE_SECRET_KEY_FILE=
APP_BILLING_STRIPE_WEBHOOK_SECRET=
APP_BILLING_STRIPE_WEBHOOK_SECRET_FILE=
APP_BILLING_STRIPE_SUCCESS_URL=
APP_BILLING_STRIPE_CANCEL_URL=
APP_BILLING_STRIPE_PORTAL_RETURN_URL=
APP_BILLING_STRIPE_AUTOMATIC_TAX_ENABLED=true
APP_BILLING_STRIPE_TAX_ID_COLLECTION_ENABLED=true
# Keep false during normal operation. A controlled LIVE catalog maintenance
# window may set it true temporarily; the API still requires Root authority
# and the exact confirmation phrase.
APP_BILLING_STRIPE_CATALOG_LIVE_SYNC_ENABLED=false
APP_BILLING_STRIPE_PRICE_BASIC_1_MONTHLY=
APP_BILLING_STRIPE_PRICE_BASIC_1_ANNUAL=
APP_BILLING_STRIPE_PRICE_BASIC_2_MONTHLY=
APP_BILLING_STRIPE_PRICE_BASIC_2_ANNUAL=
APP_BILLING_STRIPE_PRICE_BASIC_3_MONTHLY=
APP_BILLING_STRIPE_PRICE_BASIC_3_ANNUAL=
APP_BILLING_STRIPE_PRICE_BASIC_ALL_MONTHLY=
APP_BILLING_STRIPE_PRICE_BASIC_ALL_ANNUAL=
APP_BILLING_STRIPE_PRICE_EXTRA_SEAT_MONTHLY=
APP_BILLING_STRIPE_PRICE_EXTRA_SEAT_ANNUAL=
# Optional storage overage. Each recurring block represents 5 GiB; its price
# must be approved before configuring the Stripe Price IDs.
APP_BILLING_STRIPE_PRICE_STORAGE_BLOCK_MONTHLY=
APP_BILLING_STRIPE_PRICE_STORAGE_BLOCK_ANNUAL=
APP_BILLING_STRIPE_PROCESSOR_ENABLED=false
APP_BILLING_PROVISIONING_ENABLED=false
APP_BILLING_PROVISIONING_RECONCILIATION_BATCH_SIZE=25

# Commercial capabilities are observed and projected before they can block a
# tenant. Enforcement additionally requires an enrolled company in ENFORCE.
APP_ENTITLEMENTS_SHADOW_ENABLED=true
APP_ENTITLEMENTS_ENFORCEMENT_ENABLED=false
APP_ENTITLEMENTS_PROJECTION_ENABLED=true
APP_ENTITLEMENTS_PROJECTION_DELAY_MS=60000
APP_ENTITLEMENTS_PROJECTION_BATCH_SIZE=100

# Delinquency automation is installed but remains inert until a controlled
# Phase 8 cohort has completed the test-clock certification.
APP_BILLING_LIFECYCLE_ENABLED=false
APP_BILLING_LIFECYCLE_SCHEDULER_ENABLED=false
APP_BILLING_LIFECYCLE_GRACE_DAYS=14
APP_BILLING_LIFECYCLE_READ_ONLY_DAYS=14
APP_BILLING_LIFECYCLE_RETENTION_DAYS=90
APP_BILLING_LIFECYCLE_SCHEDULER_DELAY_MS=60000
APP_BILLING_LIFECYCLE_SCHEDULER_BATCH_SIZE=100

# Premium storage remains shadow-only until reconciliation has no unresolved
# objects for the launch cohort. Includes 5 GiB; each extra block is 5 GiB.
APP_BILLING_STORAGE_ENFORCEMENT_ENABLED=false
APP_BILLING_STORAGE_INCLUDED_BYTES=5368709120
APP_BILLING_STORAGE_BLOCK_BYTES=5368709120
APP_BILLING_STORAGE_RESERVATION_TTL_MINUTES=30
APP_BILLING_STORAGE_CLEANUP_BATCH_SIZE=200
APP_BILLING_STORAGE_CLEANUP_DELAY_MS=300000

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_ENABLED=true

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
# Replace these placeholders with images tagged by the deployed Git commit.
# Host-network production deploys reject the mutable :latest application tag.
WEB_IMAGE=indice-erp-web:git-REPLACE_ME
BACKEND_IMAGE=indice-erp-backend:git-REPLACE_ME
ALLOW_MUTABLE_APP_IMAGES=false
DEPLOY_MIN_FREE_MB=10240
DEPLOY_DRY_RUN=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_ATTENDANCE=indice-hr-attendance
MINIO_BUCKET_BIOMETRIC=indice-hr-biometric
MINIO_BUCKET_DOCUMENTS=indice-hr-documents
MINIO_BUCKET_SALES_DOCUMENTS=indice-sales-documents
MINIO_PRESIGN_EXPIRY_SECONDS=900
APP_STORAGE_REQUIRED=true

WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8082
MYSQL_HOST_PORT=3307
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
FACE_SERVICE_HOST_PORT=8091

WEB_PUBLIC_URL=http://localhost:8080
MINIO_PUBLIC_ENDPOINT=http://localhost:8080/storage
APP_WEB_ALLOWED_ORIGINS=http://localhost:8080
APP_WEB_BASE_URL=http://localhost:8080
APP_WEB_PUBLIC_URL=http://localhost:8080
APP_WEB_INVITATION_BASE_URL=http://localhost:8080
APP_PRODUCT_ANALYTICS_WEB_INGEST_TOKEN=
MINIO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=lax
APP_SESSION_TIMEOUT=12h
APP_AUTH_MFA_REQUIRED=true
SERVER_FORWARD_HEADERS_STRATEGY=framework
APP_HR_ATTENDANCE_ENFORCE_LOCATION_RADIUS=false
APP_HR_FACE_ENABLED=true
APP_HR_FACE_SESSION_EXPIRY_SECONDS=600
APP_HR_KIOSK_IDENTIFICATION_TOKEN_SECRET=change-this-to-a-long-random-production-secret
APP_HR_KIOSK_IDENTIFICATION_TOKEN_TTL_SECONDS=180
APP_HR_KIOSK_INACTIVITY_TIMEOUT_SECONDS=180
APP_EXPENSES_KIOSK_INACTIVITY_TIMEOUT_SECONDS=300
APP_EXPENSES_KIOSK_SESSION_TTL_SECONDS=28800
APP_PETTY_CASH_KIOSK_INACTIVITY_TIMEOUT_SECONDS=900
APP_PETTY_CASH_KIOSK_SESSION_TTL_SECONDS=14400
APP_PROCESS_TASKS_KIOSK_INACTIVITY_TIMEOUT_SECONDS=1800
APP_PROCESS_TASKS_KIOSK_SESSION_TTL_SECONDS=28800
APP_KIOSK_TOKEN_PROTECTION_SECRET=change-this-to-a-different-long-random-production-secret
KIOSK_ENGINE_ADAPTER_PETTY_CASH_ENABLED=false
KIOSK_GLOBAL_CENTER_ENABLED=false
KIOSK_MULTI_DASHBOARD_ENABLED=false
KIOSK_EMPLOYEE_CENTER_ENABLED=false
KIOSK_EMPLOYEE_CENTER_INACTIVITY_TIMEOUT_SECONDS=28800
KIOSK_MULTI_INACTIVITY_TIMEOUT_SECONDS=28800
KIOSK_MULTI_SESSION_TTL_SECONDS=43200
APP_EMAIL_ENABLED=true
APP_EMAIL_PROVIDER=sendgrid
APP_EMAIL_FROM=contacto@indiceapp.com
APP_EMAIL_FROM_ADDRESS=contacto@indiceapp.com
APP_EMAIL_FROM_NAME=Indice
APP_EMAIL_REPLY_TO=
APP_EMAIL_SENDGRID_API_KEY=
APP_CONSULTING_TEAM_EMAIL=consultoria@indiceapp.com
APP_CONSULTING_ADDITIONAL_SESSION_AMOUNT_CENTS=7900
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

VITE_API_BASE_URL=
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
EXPECT_OBJECT_STORAGE=true
SMOKE_TEST_AUTH_ROUTE=true
