{
  "name": "@indice/indice-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:contract": "npm run build && node dist/test/contract-runner.js",
    "test:http-contract": "npm run build && node dist/test/http-contract-runner.js",
    "test:v1-e2e": "INDICE_E2E_COMMIT_ACTIONS=true npm run test:http-contract"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
