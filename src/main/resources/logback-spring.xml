<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="safeMsg" class="com.indice.erp.observability.SanitizingMessageConverter"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="indice-erp-api"/>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="APP_LOG_LEVEL" source="logging.level.com.indice.erp" defaultValue="INFO"/>
    <springProperty scope="context" name="FLYWAY_LOG_LEVEL" source="logging.level.org.flywaydb" defaultValue="INFO"/>
    <springProperty scope="context" name="HIKARI_LOG_LEVEL" source="logging.level.com.zaxxer.hikari" defaultValue="INFO"/>
    <springProperty scope="context" name="SPRING_WEB_LOG_LEVEL" source="logging.level.org.springframework.web" defaultValue="INFO"/>
    <springProperty scope="context" name="JDBC_LOG_LEVEL" source="logging.level.org.springframework.jdbc.core" defaultValue="INFO"/>

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] requestId=%X{requestId} %logger{36} - %safeMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>25MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>25MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="org.springframework.jdbc.core" level="${JDBC_LOG_LEVEL}"/>
    <logger name="org.flywaydb" level="${FLYWAY_LOG_LEVEL}"/>
    <logger name="com.zaxxer.hikari" level="${HIKARI_LOG_LEVEL}"/>
    <logger name="org.springframework.web" level="${SPRING_WEB_LOG_LEVEL}"/>
    <logger name="com.indice.erp" level="${APP_LOG_LEVEL}"/>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
